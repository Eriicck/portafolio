---
// Fondo decorativo de puntos y círculos
interface Props { accent?: string; uid: string }
const { accent = '#22c55e', uid } = Astro.props
---
<div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
  <svg class="absolute inset-0 w-full h-full" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <pattern id={`p-${uid}`} x="0" y="0" width="32" height="32" patternUnits="userSpaceOnUse">
        <circle cx="1" cy="1" r="1.5" class="fill-black/10 dark:fill-white/[0.13]" />
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill={`url(#p-${uid})`} />
    <circle cx="92%" cy="8%"  r="220" fill="none" stroke={accent} stroke-opacity=".18" stroke-width="2" />
    <circle cx="92%" cy="8%"  r="380" fill="none" stroke={accent} stroke-opacity=".09" stroke-width="1.5" />
    <circle cx="92%" cy="8%"  r="520" fill="none" stroke={accent} stroke-opacity=".05" stroke-width="1" />
    <circle cx="7%"  cy="92%" r="180" fill="none" stroke-width="1.5" class="stroke-black/[0.08] dark:stroke-white/[0.08]" />
    <circle cx="7%"  cy="92%" r="300" fill="none" stroke-width="1" stroke-opacity=".5" class="stroke-black/[0.08] dark:stroke-white/[0.08]" />
    <line x1="0%" y1="110%" x2="35%" y2="-10%" stroke={accent} stroke-opacity=".12" stroke-width="1.5" />
    <circle cx="8%"  cy="10%" r="60"  fill={accent} fill-opacity=".07" />
    <circle cx="18%" cy="22%" r="5"   fill={accent} fill-opacity=".35" />
    <circle cx="82%" cy="68%" r="3.5" fill={accent} fill-opacity=".25" />
    <circle cx="72%" cy="15%" r="2.5" fill={accent} fill-opacity=".30" />
    <line x1="0%" y1="60%" x2="15%" y2="60%" stroke={accent} stroke-opacity=".15" stroke-width="1.5" />
  </svg>
</div>
