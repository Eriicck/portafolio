---
import { TECH } from '../data/site.js'
---
<section class="py-16 border-t overflow-hidden border-zinc-100 bg-white dark:border-zinc-900 dark:bg-zinc-950">
  <h2 class="text-center text-[11px] font-bold uppercase tracking-[0.3em] mb-8 text-zinc-500 dark:text-zinc-400">Stack tecnológico</h2>
  <div class="relative">
    <div class="absolute left-0 top-0 w-20 h-full z-10 pointer-events-none bg-gradient-to-r from-white dark:from-zinc-950 to-transparent"></div>
    <div class="absolute right-0 top-0 w-20 h-full z-10 pointer-events-none bg-gradient-to-l from-white dark:from-zinc-950 to-transparent"></div>
    <div class="overflow-hidden">
      <!-- La lista va dos veces para que la cinta no tenga cortes -->
      <ul class="ticker-wrap flex items-center gap-12 whitespace-nowrap w-max">
        {[...TECH, ...TECH].map((t, i) => (
          <li class="ticker-item flex flex-col items-center gap-2 shrink-0 cursor-default" aria-hidden={i >= TECH.length ? 'true' : undefined}>
            <img src={t.logo} alt={i < TECH.length ? t.name : ''} width={t.width} height="36" loading="lazy" decoding="async" class:list={['h-9 w-auto object-contain', t.invert && 'logo-invert']} />
            <span class="text-[11px] font-mono tracking-widest text-zinc-500 dark:text-zinc-400">{t.name}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
