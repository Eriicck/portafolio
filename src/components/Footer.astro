---
import { SITE } from '../data/site.js'
---
<footer class="border-t py-6 mb-16 md:mb-0 border-zinc-200 bg-white text-zinc-500 dark:border-zinc-900 dark:bg-zinc-950 dark:text-zinc-400">
  <div class="container mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-8">
    <div class="flex items-center gap-3">
      <span class="font-display font-bold tracking-tighter text-lg">{SITE.short}</span>
      <span class="text-xs uppercase tracking-[0.3em] font-medium">&mdash; {new Date().getFullYear()}</span>
    </div>
  </div>
</footer>
