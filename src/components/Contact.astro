---
import ContactForm from './ContactForm.jsx'
import { SITE } from '../data/site.js'
---
<section id="contacto" class="relative pb-32 md:pb-0 overflow-hidden">
  <div class="absolute inset-0 parallax-contact opacity-10 dark:opacity-20"></div>
  <div class="absolute inset-0 bg-white/90 dark:bg-zinc-950/90"></div>

  <div class="relative z-10 flex flex-col">
    <div data-reveal class="pt-24 pb-10 text-center px-6">
      <h2 class="font-display text-4xl md:text-6xl font-bold text-accent">CONTACTO</h2>
    </div>

    <div class="w-full h-px bg-zinc-200 dark:bg-zinc-800"></div>

    <div class="flex-1 grid md:grid-cols-2 relative">
      <div class="flex flex-col justify-center px-10 md:px-16 py-10 md:py-0 bg-[#f8f8f8] dark:bg-zinc-950">
        <div data-reveal>
          <h3 class="font-display text-4xl md:text-5xl font-bold leading-tight mb-6 text-black dark:text-white">
            ¿Tienes algo<br /><span class="text-accent">en mente?</span>
          </h3>
          <p class="text-lg font-light leading-relaxed max-w-sm text-zinc-600 dark:text-zinc-400">
            Cuéntame tu idea — te respondo en menos de 24 horas.
          </p>
        </div>
      </div>

      <div class="hidden md:block absolute left-1/2 top-0 bottom-0 w-px bg-zinc-200 dark:bg-zinc-800"></div>

      <div class="flex flex-col justify-center px-10 md:px-16 py-16 md:py-0">
        <div data-reveal style="--reveal-delay:150ms">
          <ContactForm client:visible email={SITE.email} />
        </div>
      </div>
    </div>
  </div>
</section>
