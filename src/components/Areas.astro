---
import VectorBg from './VectorBg.astro'
import ServiceIcon from './ServiceIcon.astro'
import { SERVICES } from '../data/services.js'
---
<section id="work" data-reveal class="relative py-28 border-t overflow-hidden border-zinc-100 bg-zinc-50 dark:border-zinc-900 dark:bg-zinc-900/40">
  <VectorBg uid="work" />
  <div class="relative z-10 container mx-auto px-6">
    <div class="mb-20 max-w-2xl">
      <h2 class="font-display text-3xl md:text-5xl font-bold mb-4 text-black dark:text-white">Áreas de trabajo</h2>
      <p class="text-xl font-light text-zinc-600 dark:text-zinc-400">Soluciones digitales de punta a punta — desde diseño visual hasta automatización total del negocio.</p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
      {SERVICES.map((s) => (
        <a href={`/services/${s.slug}`}
          class="block p-7 border rounded-2xl transition-all hover:border-green-500/30 hover:scale-[1.02] bg-white border-zinc-200 shadow-sm dark:bg-zinc-900 dark:border-zinc-800 dark:shadow-none">
          <div class="w-12 h-12 rounded-xl flex items-center justify-center mb-6 border bg-zinc-50 text-black border-zinc-200 dark:bg-zinc-800 dark:text-white dark:border-zinc-700">
            <ServiceIcon name={s.icon} />
          </div>
          <h3 class="font-display text-lg font-bold mb-2 text-black dark:text-white">{s.name}</h3>
          <p class="text-sm leading-relaxed text-zinc-500 dark:text-zinc-400">{s.areaDesc}</p>
        </a>
      ))}
    </div>
  </div>
</section>
