---
import '../styles/global.css'
import Navbar from '../components/Navbar.astro'
import Footer from '../components/Footer.astro'
import { SITE } from '../data/site.js'

interface Props { title?: string; description?: string }
const { title = SITE.title, description = SITE.description } = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site)
const ogImage = new URL(SITE.ogImage, Astro.site)
---
<!doctype html>
<html lang="es" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content={SITE.name} />
  <link rel="canonical" href={canonical} />
  <meta name="theme-color" content="#09090b" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Open Graph (WhatsApp, LinkedIn, Facebook) -->
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="es_AR" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={SITE.ogDescription} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={`${SITE.name} — Sistemas que funcionan 24/7`} />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={SITE.ogDescription} />
  <meta name="twitter:image" content={ogImage} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&family=Lato:ital,wght@1,300;1,400;1,700&display=swap" rel="stylesheet" />

  <slot name="head" />

  <!-- Antes de pintar: tema guardado (oscuro por defecto) y marca de que hay JS -->
  <script is:inline>
    (() => {
      const root = document.documentElement
      root.classList.add('js')
      let theme = null
      try { theme = localStorage.getItem('theme') } catch {}
      root.classList.toggle('dark', theme !== 'light')
    })()
  </script>
</head>
<body>
  <Navbar />
  <slot />
  <Footer />

  <script>
    // Aparición de los bloques [data-reveal] cuando entran en pantalla
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target) }
      }
    }, { threshold: 0.08, rootMargin: '0px 0px 10% 0px' })
    document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el))

    // Botones de cambio de tema
    document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const dark = document.documentElement.classList.toggle('dark')
        try { localStorage.setItem('theme', dark ? 'dark' : 'light') } catch {}
      })
    })
  </script>
</body>
</html>
