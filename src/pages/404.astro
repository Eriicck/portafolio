---
import Base from '../layouts/Base.astro'
import { SITE } from '../data/site.js'
---
<Base title={`Página no encontrada — ${SITE.name}`}>
  <main class="min-h-screen flex flex-col items-center justify-center text-center px-6 bg-[#f8f8f8] dark:bg-zinc-950">
    <p class="font-display text-7xl font-bold text-accent mb-4">404</p>
    <h1 class="font-display text-2xl md:text-4xl font-bold mb-4 text-zinc-950 dark:text-white">Esta página no existe</h1>
    <p class="mb-8 text-zinc-600 dark:text-zinc-400">Puede que el link esté mal escrito o que la página se haya movido.</p>
    <a href="/" class="px-8 py-3 rounded-xl font-bold text-xs tracking-widest uppercase bg-zinc-950 text-white dark:bg-white dark:text-zinc-950">Volver al inicio</a>
  </main>
</Base>
