---
import { ArrowRight } from '@lucide/astro'
import Base from '../../layouts/Base.astro'
import ServiceIcon from '../../components/ServiceIcon.astro'
import { SERVICES } from '../../data/services.js'
import { SITE } from '../../data/site.js'

export function getStaticPaths() {
  return SERVICES.map((service) => ({ params: { slug: service.slug }, props: { service } }))
}

const { service: s } = Astro.props
---
<Base title={`${s.title} ${s.accentTitle} — ${SITE.name}`} description={s.subtitle}>
  <main class="min-h-screen pt-24 pb-28 md:pb-16 px-6 bg-[#f8f8f8] dark:bg-zinc-950" style={`--svc:${s.accent}`}>
    <div class="max-w-4xl mx-auto">
      <div data-reveal>
        <div class="flex items-center gap-4 mb-8">
          <div class="w-14 h-14 rounded-2xl flex items-center justify-center text-(--svc) bg-(--svc)/10">
            <ServiceIcon name={s.icon} size={26} />
          </div>
          <span class="text-[11px] font-bold uppercase tracking-[0.25em] text-(--svc)">Servicio</span>
        </div>
        <h1 class="font-display text-4xl sm:text-6xl font-bold mb-4 leading-tight text-zinc-950 dark:text-white">
          {s.title}<br /><span class="text-(--svc)">{s.accentTitle}</span>
        </h1>
        <p class="text-lg font-light mb-16 text-zinc-600 dark:text-zinc-400">{s.subtitle}</p>
      </div>

      <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-16">
        {s.features.map((f, i) => (
          <li data-reveal style={`--reveal-delay:${i * 60}ms`}
            class="flex items-start gap-4 p-5 rounded-2xl border bg-white border-zinc-200 dark:bg-zinc-900 dark:border-zinc-800">
            <span class="w-2 h-2 rounded-full mt-2 shrink-0 bg-(--svc)"></span>
            <span>
              <span class="block text-sm font-semibold mb-1 text-zinc-950 dark:text-white">{f.title}</span>
              <span class="block text-xs leading-relaxed text-zinc-600 dark:text-zinc-400">{f.desc}</span>
            </span>
          </li>
        ))}
      </ul>

      <div data-reveal class="p-8 rounded-3xl border text-center bg-white border-zinc-200 dark:bg-zinc-900 dark:border-zinc-800">
        <h2 class="font-display text-2xl font-bold mb-3 text-zinc-950 dark:text-white">{s.ctaTitle}</h2>
        <p class="text-sm mb-6 text-zinc-600 dark:text-zinc-400">{s.ctaDesc}</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <a href="/#contacto" class="px-8 py-3 rounded-xl font-bold text-xs tracking-widest uppercase flex items-center gap-2 transition-opacity hover:opacity-90 bg-zinc-950 text-white dark:bg-white dark:text-zinc-950">
            Contactame <ArrowRight size={14} />
          </a>
          <a href="/#proyectos" class="px-8 py-3 rounded-xl font-bold text-xs tracking-widest uppercase border transition-colors hover:border-green-500 hover:text-green-500 border-zinc-200 text-zinc-600 dark:border-zinc-800 dark:text-zinc-400">
            Ver proyectos
          </a>
        </div>
      </div>
    </div>
  </main>
</Base>
